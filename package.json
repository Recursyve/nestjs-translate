{
    "name": "nestjs-translate",
    "version": "11.0.0",
    "description": "Translate library for NestJs",
    "author": "Julien Dufresne",
    "license": "MIT",
    "scripts": {
        "compile": "tsc -p tsconfig.json",
        "compile:lib": "tsc -p tsconfig.lib.json",
        "test": "jest --config=jest.json",
        "publish-package": "npm run compile:lib && npm publish --access public",
        "publish-package:beta": "npm run compile:lib && npm publish --tag beta --access public",
        "publish-package:dry-run": "npm run compile:lib && npm publish --dry-run"
    },
    "peerDependencies": {
        "@nestjs/common": ">=11.0.0",
        "@nestjs/core": ">=11.0.0",
        "rxjs": ">=7.0.0"
    },
    "devDependencies": {
        "@nestjs/common": "^11.1.11",
        "@nestjs/core": "^11.1.11",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.19.3",
        "jest": "^30.2.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "tslint": "^6.1.3",
        "typescript": "^5.9.3"
    }
}
